<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DiscUtils.Ntfs" Version="0.16.13" PrivateAssets="all" />
    <ProjectReference Include="../../src/Shunshou.Core/Shunshou.Core.csproj" />
    <None Update="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../runtime/ocr/**" Link="tools/ocr/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
