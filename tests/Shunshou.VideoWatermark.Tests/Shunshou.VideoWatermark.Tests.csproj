<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackagedCorePath)' == ''">
    <Compile Include="../../src/Shunshou.Core/VideoWatermarkService.cs" Link="VideoWatermarkService.cs" />
    <Compile Include="../../src/Shunshou.Core/ToolProgress.cs" Link="ToolProgress.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PackagedCorePath)' != ''">
    <Reference Include="Shunshou.Core">
      <HintPath>$(PackagedCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
