<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Shunshou.App.InputFileList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shunshou.App"
    Loaded="Control_Loaded" Unloaded="Control_Unloaded">
  <Grid RowSpacing="7">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="FileCount" Text="还没有添加文件" Foreground="{ThemeResource MutedBrush}" FontSize="12"/>
    <ListView x:Name="Rows" Grid.Row="1" MaxHeight="240" SelectionMode="Single"
              SelectionChanged="Rows_SelectionChanged" HorizontalContentAlignment="Stretch"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.Name="已添加的文件，选择查看或处理，使用移除按钮从列表移除">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:InputFileItem">
          <Grid Padding="0,5" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullPath}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="58" Height="48" CornerRadius="5" Background="{ThemeResource WorkspaceBrush}">
              <Grid>
                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Visibility="{x:Bind IconVisibility, Mode=OneWay}" FontSize="24" Foreground="{ThemeResource MutedBrush}"/>
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"
                       Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded" DataContextChanged="Thumbnail_DataContextChanged"
                       AutomationProperties.Name="已添加文件缩略图"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Tag="-1" Click="Move_Click" Padding="7" Visibility="{x:Bind ReorderVisibility, Mode=OneWay}"
                      IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}" ToolTipService.ToolTip="上移"
                      AutomationProperties.Name="{x:Bind MoveUpLabel}"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
              <Button Tag="1" Click="Move_Click" Padding="7" Visibility="{x:Bind ReorderVisibility, Mode=OneWay}"
                      IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}" ToolTipService.ToolTip="下移"
                      AutomationProperties.Name="{x:Bind MoveDownLabel}"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
              <Button Click="Remove_Click" Padding="7" IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                      ToolTipService.ToolTip="从列表移除" AutomationProperties.Name="{x:Bind RemoveLabel}"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
