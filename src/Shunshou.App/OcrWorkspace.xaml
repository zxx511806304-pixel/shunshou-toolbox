<UserControl
    x:Class="Shunshou.App.OcrWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Workspace_Loaded" Unloaded="Workspace_Unloaded">
  <StackPanel x:Name="WorkspaceStack" Spacing="12" SizeChanged="WorkspaceStack_SizeChanged">
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="图片提取文字" FontSize="18" FontWeight="SemiBold"/>
        <ProgressRing x:Name="WorkingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="正在处理图片"/>
      </StackPanel>
      <Button x:Name="PasteButton" Grid.Column="1" Click="Paste_Click" AutomationProperties.Name="粘贴剪贴板图片，Ctrl加V">
        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77F;" FontSize="14"/><TextBlock Text="粘贴图片"/><TextBlock Text="Ctrl+V" Foreground="{ThemeResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
      </Button>
    </Grid>
    <InfoBar x:Name="WorkspaceNotice" IsOpen="False" IsClosable="True" Visibility="Collapsed" Severity="Warning" Closed="WorkspaceNotice_Closed"/>
    <Grid x:Name="EditorLayout" ColumnSpacing="16" RowSpacing="12" SizeChanged="EditorLayout_SizeChanged">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="0.9*"/><ColumnDefinition x:Name="TextColumn" Width="1.1*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="ImagePane" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="PreviewBodyRow" Height="300"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="原图" FontWeight="SemiBold"/>
        <Border Grid.Row="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}" Background="{ThemeResource WorkspaceBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
          <Grid>
            <Image x:Name="SourcePreview" Stretch="Uniform" AutomationProperties.Name="待识别图片预览"/>
            <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
              <FontIcon Glyph="&#xE8B9;" FontSize="32" Foreground="{ThemeResource MutedBrush}"/>
              <TextBlock x:Name="PreviewPlaceholderText" Text="添加图片，或粘贴截图" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
        <TextBlock x:Name="ImageCaption" Grid.Row="2" Text="" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTipService.ToolTip="原图保持不变"/>
      </Grid>
      <Grid x:Name="TextPane" Grid.Column="1" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="TextBodyRow" Height="300"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="识别文字" FontWeight="SemiBold"/>
        <TextBox x:Name="ResultEditor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="15" Padding="12" PlaceholderText="识别后可在这里修改文字" TextChanged="ResultEditor_TextChanged" AutomationProperties.Name="识别文字，可编辑"/>
        <Grid Grid.Row="2" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="CharacterCount" Text="0 字" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
          <Button x:Name="CopyButton" Grid.Column="1" Content="复制文字" Click="Copy_Click" IsEnabled="False" Padding="12,5"/>
          <Button x:Name="SaveButton" Grid.Column="2" Content="保存 TXT" Click="Save_Click" IsEnabled="False" Padding="12,5"/>
        </Grid>
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
