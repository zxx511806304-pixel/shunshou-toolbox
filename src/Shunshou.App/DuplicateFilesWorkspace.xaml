<UserControl x:Class="Shunshou.App.DuplicateFilesWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <TextBlock Text="选择要检查的文件夹" FontSize="16" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="AddFolderButton" Content="添加文件夹" Click="AddFolder_Click" AutomationProperties.Name="添加要检查重复文件的文件夹"/>
          <Button x:Name="RemoveFolderButton" Content="移除选中" Click="RemoveFolder_Click" AutomationProperties.Name="从列表移除选中的文件夹"/>
          <NumberBox x:Name="MinSizeBox" Header="忽略小于(MB)" Minimum="1" Maximum="1048576" SpinButtonPlacementMode="Compact" Width="160" Value="1" AutomationProperties.Name="忽略小于指定大小的文件，单位MB"/>
        </StackPanel>
        <ListView x:Name="FolderList" Height="120" SelectionMode="Single" AutomationProperties.Name="待检查的文件夹列表">
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="ScanButton" Content="开始扫描" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" Padding="20,8" AutomationProperties.Name="开始扫描重复文件"/>
          <Button x:Name="CancelScanButton" Content="取消" Click="CancelScan_Click" IsEnabled="False" AutomationProperties.Name="取消扫描"/>
          <TextBlock x:Name="ScanProgress" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="扫描结果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
          <Button x:Name="AutoCheckButton" Content="自动勾选重复项（每组保留最早修改的一个）" Click="AutoCheck_Click" IsEnabled="False" AutomationProperties.Name="自动勾选每组中除最早修改外的重复文件"/>
        </StackPanel>
        <Grid Grid.Row="2">
          <ListView x:Name="ResultsList" SelectionMode="None" AutomationProperties.Name="重复文件分组结果">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Files}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnSpacing="8" Padding="24,2,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="选择删除此文件" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="EmptyText" Text="没有发现重复文件" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
          <Button x:Name="DeleteButton" Content="删除选中到回收站" Click="Delete_Click" IsEnabled="False" AutomationProperties.Name="将选中的重复文件删除到回收站"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
