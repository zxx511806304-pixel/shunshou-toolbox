<UserControl x:Class="Shunshou.App.QrCodeWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="10">
          <TextBlock Text="生成二维码" FontSize="16" FontWeight="SemiBold"/>
          <TextBox x:Name="ContentBox" Header="内容（网址、文字或联系方式）" AcceptsReturn="True" TextWrapping="Wrap" Height="96" PlaceholderText="https://…" AutomationProperties.Name="二维码内容"/>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <NumberBox x:Name="SizeBox" Header="边长（像素）" Minimum="64" Maximum="2048" SmallChange="64" SpinButtonPlacementMode="Compact" Width="160"/>
            <ComboBox x:Name="LevelBox" Header="纠错级别" MinWidth="170"/>
            <NumberBox x:Name="MarginBox" Header="留白（模块）" Minimum="0" Maximum="16" SpinButtonPlacementMode="Compact" Width="140"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="GenerateButton" Content="生成并保存 PNG" Style="{StaticResource AccentButtonStyle}" Click="Generate_Click" Padding="20,8" AutomationProperties.Name="生成二维码并保存为图片"/>
            <TextBlock x:Name="GenerateStatus" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Width="196" Height="196" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}" Background="{ThemeResource WorkspaceBrush}">
          <Grid>
            <Image x:Name="GeneratedPreview" Stretch="Uniform" Margin="8" AutomationProperties.Name="生成的二维码预览"/>
            <TextBlock x:Name="GeneratedHint" Text="生成后在这里预览" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="196"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="10">
          <TextBlock Text="识别图片里的二维码" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="PickButton" Content="选择图片" Click="Pick_Click" AutomationProperties.Name="选择包含二维码的图片"/>
            <Button x:Name="PasteButton" Content="粘贴图片" Click="Paste_Click" AutomationProperties.Name="从剪贴板读取二维码图片，Ctrl加V"/>
            <Button x:Name="CopyResultButton" Content="复制内容" Click="CopyResult_Click" IsEnabled="False"/>
          </StackPanel>
          <TextBox x:Name="ResultBox" Header="识别结果" AcceptsReturn="True" TextWrapping="Wrap" Height="120" IsReadOnly="True" PlaceholderText="识别到的文字会显示在这里" AutomationProperties.Name="二维码识别结果"/>
          <TextBlock x:Name="DecodeStatus" Text="选择二维码截图即可在本机识别，不上传图片。" Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="DetailText" Style="{StaticResource MutedTextStyle}" FontSize="12"/>
          <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
        </StackPanel>
        <Border Grid.Column="1" Height="196" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}" Background="{ThemeResource WorkspaceBrush}">
          <Grid>
            <Image x:Name="SourcePreview" Stretch="Uniform" Margin="8" AutomationProperties.Name="待识别图片预览"/>
            <TextBlock x:Name="SourceHint" Text="选择或粘贴图片" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
