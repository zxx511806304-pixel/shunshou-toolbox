<UserControl x:Class="Shunshou.App.StartupManagerWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
          <TextBlock Text="启动项管理" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="禁用只是临时关闭，可随时恢复，不影响软件本体。标红项目可能来自临时目录或命令可疑，请谨慎处理。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click" Padding="20,8" VerticalAlignment="Top" AutomationProperties.Name="刷新启动项列表"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
        <ListView x:Name="EntryList" Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="启动项列表">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="0.8*"/>
                  <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Command}" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Source}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Company}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" Text="{Binding SuspiciousText}" VerticalAlignment="Center" Foreground="{Binding SuspiciousBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
          <ListView.HeaderTemplate>
            <DataTemplate>
              <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="0.8*"/>
                  <ColumnDefinition Width="0.8*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称 / 命令" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock Grid.Column="1" Text="来源" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock Grid.Column="2" Text="公司" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource MutedTextStyle}"/>
                <TextBlock Grid.Column="4" Text="风险" Style="{StaticResource MutedTextStyle}"/>
              </Grid>
            </DataTemplate>
          </ListView.HeaderTemplate>
        </ListView>
      </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="DisableButton" Content="禁用选中" Click="Disable_Click" IsEnabled="False" AutomationProperties.Name="禁用选中的启动项"/>
        <Button x:Name="EnableButton" Content="启用选中" Click="Enable_Click" IsEnabled="False" AutomationProperties.Name="启用选中的启动项"/>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
