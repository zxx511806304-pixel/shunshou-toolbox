<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Shunshou.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" PrivateAssets="all" />
    <ProjectReference Include="..\Shunshou.Core\Shunshou.Core.csproj" />
    <ProjectReference Include="..\Shunshou.DesktopIntegration\Shunshou.DesktopIntegration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\runtime\**" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- WinUI 1.8 copies these to the build output, but dotnet publish does not
       automatically carry the generated XAML resource files into an unpackaged app. -->
  <Target Name="IncludeCompiledWinUiResourcesForPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_ShunshouCompiledXaml Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Error Condition="'@(_ShunshouCompiledXaml)' == ''" Text="Compiled WinUI XBF files are missing from the build output." />
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The application's generated PRI resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_ShunshouCompiledXaml)">
        <RelativePath>%(_ShunshouCompiledXaml.RecursiveDir)%(_ShunshouCompiledXaml.Filename)%(_ShunshouCompiledXaml.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
