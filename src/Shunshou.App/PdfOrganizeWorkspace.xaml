<UserControl x:Class="Shunshou.App.PdfOrganizeWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="PageNumberStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageNoteStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PageRemovedStyle" TargetType="TextBlock" BasedOn="{StaticResource PageNumberStyle}">
      <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
      <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>
  </UserControl.Resources>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock x:Name="DocumentTitle" Text="先在左侧选择或拖入一份 PDF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DocumentDetail" Text="整理页序、删除不要的页、旋转方向，然后生成新的 PDF；原文件保留。" Style="{StaticResource MutedTextStyle}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button x:Name="PickButton" Content="选择 PDF" Click="Pick_Click" AutomationProperties.Name="选择要整理的 PDF"/>
            <Button x:Name="ReloadButton" Content="重新读取" Click="Reload_Click" IsEnabled="False"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="MoveUpButton" Content="上移" Click="MoveUp_Click" IsEnabled="False"/>
          <Button x:Name="MoveDownButton" Content="下移" Click="MoveDown_Click" IsEnabled="False"/>
          <Button x:Name="RemoveButton" Content="删除所选页" Click="Remove_Click" IsEnabled="False"/>
          <Button x:Name="RotateButton" Content="顺时针 90°" Click="Rotate_Click" IsEnabled="False"/>
          <Button x:Name="RemoveBlankButton" Content="删除疑似空白页" Click="RemoveBlank_Click" IsEnabled="False"/>
          <Button x:Name="RestoreButton" Content="恢复到原始" Click="Restore_Click" IsEnabled="False"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
      <Grid>
        <ListView x:Name="PageList" SelectionMode="Extended" HorizontalContentAlignment="Stretch" AutomationProperties.Name="PDF 页面列表，可多选"/>
        <TextBlock x:Name="EmptyHint" Text="还没有读取到页面。" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Spacing="8">
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="OutputBox" Header="保存到" AutomationProperties.Name="整理后 PDF 的输出文件夹"/>
        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="Browse_Click"/>
      </Grid>
    </StackPanel>
    <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="18,12">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="准备就绪" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/>
          <ProgressBar x:Name="Progress" Height="3"/>
        </StackPanel>
        <Button x:Name="OpenButton" Grid.Column="1" Content="打开文件" IsEnabled="False" Click="Open_Click" VerticalAlignment="Center"/>
        <Button x:Name="GenerateButton" Grid.Column="2" Content="生成新 PDF" Style="{StaticResource AccentButtonStyle}" Padding="22,9" IsEnabled="False" Click="Generate_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
