<UserControl
    x:Class="Shunshou.App.RecoveryWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="16,12">
      <StackPanel Spacing="10">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ModeBox" Header="查找方式" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed" AutomationProperties.Name="恢复查找方式">
            <ComboBoxItem Content="综合查找" Tag="Combined"/>
            <ComboBoxItem Content="回收站" Tag="RecycleBin"/>
            <ComboBoxItem Content="删除记录" Tag="FileRecords"/>
            <ComboBoxItem Content="深度扫描" Tag="DeepScan"/>
            <ComboBoxItem Content="已有备份" Tag="BackupFolder"/>
          </ComboBox>
          <ComboBox x:Name="DriveBox" Grid.Column="1" Header="原文件所在磁盘" HorizontalAlignment="Stretch" SelectionChanged="Drive_Changed" AutomationProperties.Name="恢复源磁盘"/>
          <Button x:Name="SourceButton" Grid.Column="2" Content="选择镜像" VerticalAlignment="Bottom" Click="ChooseSource_Click"/>
        </Grid>
        <TextBlock x:Name="SourceLabel" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <TextBox x:Name="NameFilter" Header="文件名" PlaceholderText="例如：毕业论文" TextChanged="Filter_Changed" AutomationProperties.Name="恢复文件名筛选"/>
          <TextBox x:Name="TypeFilter" Grid.Column="1" Header="格式" PlaceholderText="例如：jpg, pdf, docx" TextChanged="Filter_Changed" AutomationProperties.Name="恢复文件格式筛选"/>
        </Grid>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="OutputFolder" Header="恢复保存到" PlaceholderText="选择另一个磁盘上的文件夹" AutomationProperties.Name="恢复保存位置"/>
          <Button x:Name="OutputButton" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="ChooseOutput_Click"/>
        </Grid>
        <TextBlock x:Name="ModeHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" Padding="12">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="CountLabel" Text="找到的文件" FontWeight="SemiBold"/><Button Content="全选" HorizontalAlignment="Right" Click="SelectAll_Click" Padding="10,3"/></Grid>
          <ListView x:Name="Results" Grid.Row="1" SelectionMode="Multiple" HorizontalContentAlignment="Stretch" SelectionChanged="Selection_Changed" AutomationProperties.Name="可恢复文件列表">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Padding="2,6" Spacing="4" ToolTipService.ToolTip="{Binding OriginalPath}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="选择磁盘，开始查找" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" IsHitTestVisible="False"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="文件预览" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="OcrButton" Content="提取文字" HorizontalAlignment="Right" Padding="8,4" FontSize="12" IsEnabled="False" Click="ReadImageText_Click" AutomationProperties.Name="识别恢复图片中的文字"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
            <Border Height="140" Background="{ThemeResource WorkspaceBrush}" CornerRadius="6"><Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="恢复图片预览"/></Border>
            <TextBlock x:Name="PreviewName" Text="选中一个文件查看" TextWrapping="Wrap"/>
            <TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
            <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="180" Visibility="Collapsed" AutomationProperties.Name="恢复文字预览"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8">
      <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock x:Name="ProgressText" Text="准备就绪" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="Progress" IsIndeterminate="False" Height="3"/></StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="停止" Click="Cancel_Click" IsEnabled="False"/>
        <Button x:Name="CopyButton" Grid.Column="2" Content="恢复选中" Click="Copy_Click" IsEnabled="False"/>
        <Button x:Name="ScanButton" Grid.Column="3" Content="开始查找" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click"/>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
