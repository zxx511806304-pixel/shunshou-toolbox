<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Shunshou.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Shunshou.App" Title="顺手工具箱">
  <Grid x:Name="RootLayout" Background="{ThemeResource WorkspaceBrush}" Loaded="Root_Loaded">
    <Grid.Resources><ResourceDictionary Source="ms-appx:///ToolboxTheme.xaml"/></Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="TitleArea" Padding="20,0,150,0" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <Grid x:Name="TitleDragArea">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="ms-appx:///Assets/Toolbox.png" Width="25" Height="25"/>
        <TextBlock Text="顺手工具箱" FontWeight="SemiBold" FontSize="15"/>
        <TextBlock Text="/" Foreground="{ThemeResource MutedBrush}" Margin="8,0"/>
        <TextBlock Text="日常学习 · 高效办公" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
      </StackPanel>
      </Grid>
      <Button x:Name="ThemeToggleButton" Grid.Column="1" Width="36" Height="34" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="ThemeToggle_Click" AutomationProperties.Name="切换为深色主题"><local:ToolIcon x:Name="ThemeToggleIcon" Kind="moon" Width="19" Height="19"/></Button>
      <Button Grid.Column="2" Width="36" Height="34" Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="更多" ToolTipService.ToolTip="更多">
        <TextBlock Text="···" FontSize="22" VerticalAlignment="Center"/>
        <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="关于顺手工具箱" Click="About_Click"/></MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="214" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="Navigation_SelectionChanged" PaneTitle="我的工具">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="压缩与打包" Tag="compression"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="PDF 处理" Tag="pdf"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="图片与文字" Tag="image"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B9;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="音频与视频" Tag="media"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="文件搜索整理" Tag="files"><NavigationViewItem.Icon><FontIcon Glyph="&#xE721;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="软件卸载" Tag="software"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemSeparator/>
        <NavigationViewItem x:Name="ShopNavigationItem" Content="顺手小店" Tag="shop"><NavigationViewItem.Icon><FontIcon Glyph="&#xE719;"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Padding="18,12,18,24" Spacing="9">
          <Border Background="Transparent" CornerRadius="6" Padding="0,7" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon x:Name="ConnectionStatusIcon" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource BrandBrush}"/><TextBlock x:Name="ConnectionStatusText" Text="本地处理 · 离线可用" FontSize="12" Foreground="{ThemeResource BrandBrush}"/></StackPanel></Border>
        </StackPanel>
      </NavigationView.PaneFooter>
      <Grid Padding="28,18,28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20" Spacing="7">
          <TextBlock x:Name="CategoryTitle" Text="压缩与打包" FontSize="26" FontWeight="Medium"/>
          <TextBlock x:Name="CategorySubtitle" Text="把文件处理到刚好能提交。复杂参数，交给工具箱。" Style="{StaticResource MutedTextStyle}"/>
        </StackPanel>
        <Border x:Name="OperationCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,4,12">
          <StackPanel Spacing="9">
            <Grid x:Name="OperationButtons" ColumnSpacing="8" RowSpacing="8"/>
            <TextBlock x:Name="OperationDescription" Style="{StaticResource MutedTextStyle}"/>
            <ComboBox x:Name="OperationBox" Visibility="Collapsed" SelectionChanged="Operation_SelectionChanged"/>
          </StackPanel>
        </Border>
        <Grid x:Name="GeneralArea" Grid.Row="2" RowSpacing="12" Margin="0,0,4,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><Border Width="24" Height="24" Background="{ThemeResource BrandSoftBrush}" CornerRadius="6"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"/></Border><TextBlock Text="添加要处理的文件" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="AddFilesButton" Content="选择文件" Click="AddFiles_Click" AutomationProperties.Name="选择要处理的文件"/><Button x:Name="AddFolderButton" Content="选择文件夹" Click="AddFolder_Click" AutomationProperties.Name="选择要处理的文件夹"/><Button x:Name="ClearButton" Content="清空" Click="Clear_Click" AutomationProperties.Name="清空已选择的文件" Padding="12,4"/></StackPanel></Grid>
                <Border x:Name="InputDropHint" Background="{ThemeResource WorkspaceBrush}" CornerRadius="8" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" Padding="14">
                  <Grid ColumnSpacing="18" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:ToolIcon Kind="upload" Width="25" Height="25"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="InputTitle" Text="拖入 ZIP 压缩包或图片文件夹" FontSize="15" FontWeight="Medium" TextWrapping="Wrap"/><TextBlock x:Name="InputHint" Text="保留图片与目录结构，生成新的提交包" Style="{StaticResource MutedTextStyle}"/></StackPanel></Grid>
                    <TextBlock x:Name="SelectionSummary" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"/>
                  </Grid>
                </Border>
                <local:InputFileList x:Name="InputList"/>
              </StackPanel>
            </Border>
          <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Padding="0,0,0,4">
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="24" Height="24" Background="{ThemeResource BrandSoftBrush}" CornerRadius="6"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BrandBrush}"/></Border><TextBlock Text="设置处理方式" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/></StackPanel>
                <Grid ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                  <StackPanel x:Name="TargetPanel" Spacing="6"><NumberBox x:Name="TargetSize" Header="上传大小上限（MB）" Value="20" Minimum="0.1" Maximum="100000" SmallChange="1" SpinButtonPlacementMode="Compact" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="上传大小上限，单位MB"/><TextBlock Text="1 MB = 1,000,000 字节，输出会留少量余量。" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                  <StackPanel x:Name="LossyPanel" Grid.Column="1" Spacing="4"><CheckBox x:Name="AllowLossy" Checked="Lossy_Changed" Unchecked="Lossy_Changed" Content="允许调整图片质量，尽量达到上限" IsChecked="True"/><CheckBox x:Name="AllowResize" Content="必要时允许降低图片尺寸" IsChecked="False"/><TextBlock Text="无损压缩不保证固定大小；调整质量可能损失细节，请检查结果。" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                </Grid>
                <StackPanel x:Name="FormatPanel" Orientation="Horizontal" Spacing="20" Visibility="Collapsed"><ComboBox x:Name="FormatBox" Header="输出格式" MinWidth="180" AutomationProperties.Name="输出格式"/><NumberBox x:Name="ImageQuality" Header="图片质量（1–100）" Value="90" Minimum="1" Maximum="100" Width="180" SpinButtonPlacementMode="Compact" AutomationProperties.Name="图片质量"/></StackPanel>
                <StackPanel x:Name="PdfPanel" Spacing="8" Visibility="Collapsed"><NumberBox x:Name="PdfDpi" Header="导出分辨率（DPI）" Value="150" Minimum="72" Maximum="600" SmallChange="50" Width="220" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact" AutomationProperties.Name="PDF图片分辨率"/><TextBlock Text="默认 150 DPI；精细文字可选 300 DPI。长图采用 PNG，不自动降低清晰度，页数多时会占用更多内存。" Style="{StaticResource MutedTextStyle}"/></StackPanel>
                <StackPanel x:Name="RenamePanel" Orientation="Horizontal" Spacing="16" Visibility="Collapsed"><TextBox x:Name="RenamePrefix" Header="统一名称前缀" Text="资料" MinWidth="220"/><NumberBox x:Name="RenameStart" Header="起始序号" Value="1" Minimum="0" Width="150" SpinButtonPlacementMode="Compact"/></StackPanel>
                <InfoBar x:Name="FeatureNote" IsOpen="False" IsClosable="False" Severity="Informational"/>
                <Grid x:Name="OutputPanel" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputDirectory" Header="保存到" AutomationProperties.Name="输出文件夹"/><Button Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="ChooseOutput_Click" AutomationProperties.Name="选择输出文件夹"/></Grid>
                <Expander x:Name="AdvancedPanel" Header="更多图片设置" HorizontalAlignment="Stretch" Visibility="Collapsed"><NumberBox x:Name="ImageWidth" Header="最大宽度（像素，0 表示保持原尺寸）" Value="0" Minimum="0" Maximum="50000" Width="340" HorizontalAlignment="Left" SpinButtonPlacementMode="Compact"/></Expander>
              </StackPanel>
            </Border>
            <Border x:Name="ResultPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel Spacing="12"><TextBlock Text="处理结果" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="ResultText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" AutomationProperties.Name="处理结果详情"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        </Grid>
        <Grid x:Name="SearchWorkspace" Grid.Row="2" Visibility="Collapsed" RowSpacing="12" Margin="0,0,4,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" Padding="16,12">
            <StackPanel Spacing="8">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="225"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchQuery" Header="要查找的名称" PlaceholderText="输入名称，按 Enter 搜索" KeyDown="SearchQuery_KeyDown" AutomationProperties.Name="要查找的文件或文件夹名称"/>
                <ComboBox x:Name="SearchScopeBox" Grid.Column="1" Header="搜索范围" HorizontalAlignment="Stretch" SelectionChanged="SearchScope_Changed" AutomationProperties.Name="搜索范围"/>
                <CheckBox x:Name="ImagesOnly" Grid.Column="2" Content="只看图片" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
              </Grid>
              <Grid x:Name="SearchFolderPanel" Visibility="Collapsed" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchFolderLabel" Text="选择文件夹，或将文件夹拖入窗口" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                <Button x:Name="ChooseSearchFolderButton" Grid.Column="1" Content="选择文件夹" Click="ChooseSearchFolder_Click"/>
              </Grid>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="12">
              <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="SearchCount" Text="搜索结果" FontWeight="SemiBold" Margin="4,0"/>
                <ListView x:Name="SearchResults" Grid.Row="1" SelectionMode="Single" SelectionChanged="SearchResults_SelectionChanged" DoubleTapped="SearchResults_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.Name="搜索结果，选择查看预览，双击打开">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Padding="2,7" ColumnSpacing="12" ToolTipService.ToolTip="{Binding FullPath}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Height="66" CornerRadius="6" Background="{ThemeResource WorkspaceBrush}">
                          <Grid><FontIcon Glyph="{Binding Glyph}" Visibility="{Binding IconVisibility}" FontSize="28" Foreground="{ThemeResource MutedBrush}"/><Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="SearchThumbnail_Loaded" Unloaded="SearchThumbnail_Unloaded" DataContextChanged="SearchThumbnail_DataContextChanged" AutomationProperties.Name="文件缩略图"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource MutedBrush}" FontSize="12"/>
                          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource MutedBrush}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="SearchEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
                  <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource MutedBrush}"/>
                  <TextBlock x:Name="SearchEmptyText" Text="输入文件或文件夹名称" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
              <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="文件预览" FontSize="16" FontWeight="SemiBold"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                  <Border Height="150" CornerRadius="8" Background="{ThemeResource WorkspaceBrush}">
                    <Grid><FontIcon x:Name="PreviewIcon" Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource MutedBrush}"/><Image x:Name="SelectedPreview" Stretch="Uniform" AutomationProperties.Name="选中文件预览"/><ProgressRing x:Name="PreviewLoading" IsActive="False" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"/></Grid>
                  </Border>
                  <TextBlock x:Name="PreviewName" Text="选择结果查看预览" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="PreviewDetail" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="PreviewPath" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
                </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button x:Name="OpenSearchItemButton" Content="打开" Click="OpenSearchItem_Click" IsEnabled="False"/><Button x:Name="RevealSearchItemButton" Content="打开位置" Click="RevealSearchItem_Click" IsEnabled="False"/></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid x:Name="OcrArea" Grid.Row="2" Visibility="Collapsed" RowSpacing="10" Margin="0,0,4,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" Padding="14,10">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <local:InputFileList x:Name="OcrInputList"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top"><Button x:Name="OcrAddButton" Content="添加图片" Click="AddFiles_Click"/><Button x:Name="OcrClearButton" Content="清空" Click="Clear_Click"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><local:OcrWorkspace x:Name="OcrEditor"/></ScrollViewer>
          </Border>
        </Grid>
        <local:UninstallerWorkspace x:Name="Uninstaller" Grid.Row="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <local:VideoWorkspace x:Name="VideoTools" Grid.Row="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <local:SubtitleWorkspace x:Name="SubtitleTools" Grid.Row="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <local:WebPdfWorkspace x:Name="WebPdfTools" Grid.Row="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <local:RecoveryWorkspace x:Name="Recovery" Grid.Row="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <local:ShopWorkspace x:Name="ShopArea" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Margin="0,0,4,0"/>
        <InfoBar x:Name="StatusInfo" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="0,8,4,0"/>
        <Border x:Name="RunFooter" Grid.Row="4" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20,14" Margin="0,12,4,0">
          <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="7" VerticalAlignment="Center"><TextBlock x:Name="ProgressText" Text="准备就绪 · 文件只在你的电脑处理" Style="{StaticResource MutedTextStyle}"/><ProgressBar x:Name="TaskProgress" Minimum="0" Maximum="100" Value="0" Height="3"/></StackPanel><Button x:Name="OpenOutputButton" Grid.Column="1" Content="打开输出" IsEnabled="False" Click="OpenOutput_Click" VerticalAlignment="Center"/><Button x:Name="CancelButton" Grid.Column="2" Content="取消" IsEnabled="False" Click="Cancel_Click" VerticalAlignment="Center"/><Button x:Name="RunButton" Grid.Column="3" Content="开始处理" Style="{StaticResource AccentButtonStyle}" Padding="25,10" Click="Run_Click" AutomationProperties.Name="开始处理文件" VerticalAlignment="Center"/></Grid>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
