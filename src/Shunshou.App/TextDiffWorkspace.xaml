<UserControl x:Class="Shunshou.App.TextDiffWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="DiffSameStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="IsTextSelectionEnabled" Value="True"/>
    </Style>
    <Style x:Key="DiffAddedStyle" TargetType="TextBlock" BasedOn="{StaticResource DiffSameStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DiffRemovedStyle" TargetType="TextBlock" BasedOn="{StaticResource DiffSameStyle}">
      <Setter Property="Foreground" Value="{ThemeResource TextBrush}"/>
      <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>
    <Style x:Key="DiffNumberStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
  </UserControl.Resources>
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBox x:Name="LeftText" Header="第一份（原文）" AcceptsReturn="True" TextWrapping="Wrap" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="粘贴或输入第一份文本" AutomationProperties.Name="第一份文本"/>
          <TextBox x:Name="RightText" Grid.Column="1" Header="第二份（修改后）" AcceptsReturn="True" TextWrapping="Wrap" Height="170" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="粘贴或输入第二份文本" AutomationProperties.Name="第二份文本"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox x:Name="IgnoreWhitespace" Content="忽略空格差异"/>
          <CheckBox x:Name="IgnoreCase" Content="忽略大小写"/>
          <Button x:Name="CompareButton" Content="开始对比" Style="{StaticResource AccentButtonStyle}" Click="Compare_Click" AutomationProperties.Name="开始对比两份文本"/>
          <Button x:Name="SwapButton" Content="交换左右" Click="Swap_Click"/>
          <Button x:Name="ClearButton" Content="清空" Click="Clear_Click"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" Text="粘贴两份文本后点“开始对比”，只在本机比较，不上传内容。" Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite"/>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ResultTitle" Text="对比结果" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <CheckBox x:Name="ShowSame" Grid.Column="1" Content="同时显示相同行" Checked="ShowSame_Changed" Unchecked="ShowSame_Changed" VerticalAlignment="Center"/>
          <Button x:Name="CopyButton" Grid.Column="2" Content="复制差异" Click="Copy_Click" IsEnabled="False" Visibility="Collapsed" AutomationProperties.Name="复制差异结果"/>
        </Grid>
        <ListView x:Name="DiffList" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch" IsItemClickEnabled="False" AutomationProperties.Name="文本差异列表"/>
        <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="还没有对比结果。两份文本完全一致时，这里会显示“没有差异”。" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" TextAlignment="Center" IsHitTestVisible="False"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
          <Button x:Name="CopyDifferencesButton" Content="复制差异（仅增删行）" Click="CopyDiffs_Click" IsEnabled="False"/>
          <Button x:Name="CopyFullButton" Content="复制完整对比" Click="CopyFull_Click" IsEnabled="False"/>
          <Button x:Name="SaveButton" Content="保存为 TXT" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
