<Window x:Class="Shunshou.App.QuickLauncherWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="Root" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceStrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="12,10">
    <Grid RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="QueryBox" PlaceholderText="搜索工具、文件，或输入算式" TextChanged="Query_TextChanged" KeyDown="Query_KeyDown"/>
      <Grid Grid.Row="1">
        <ListView x:Name="Results" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Results_ItemClick" KeyDown="Results_KeyDown">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyHint" Text="输入以搜索工具、文件，或输入算式（Esc 关闭）" Foreground="{ThemeResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
