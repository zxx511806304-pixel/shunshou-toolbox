<UserControl x:Class="Shunshou.App.DiskCleanupWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <TextBlock Text="C盘清理" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="只清理系统与应用的缓存、临时文件，不会动你的个人文件、聊天记录或文档。扫描只统计大小，不会删除任何内容。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="ScanButton" Content="扫描可清理项目" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" Padding="20,8" AutomationProperties.Name="扫描可清理项目"/>
          <TextBlock x:Name="ScanStatus" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="扫描结果" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="TotalText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock x:Name="EmptyHint" Text="尚未扫描。点击上方「扫描可清理项目」开始。" Style="{StaticResource MutedTextStyle}" Margin="0,8"/>
            <ItemsControl x:Name="ResultList" AutomationProperties.Name="可清理项目列表">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="10,8" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeBrush}" Margin="0,0,0,6">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <CheckBox x:Name="PickBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="勾选后参与清理"/>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="需要管理员权限" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding RequiresAdmin}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource MutedTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
          <Button x:Name="CleanButton" Content="清理选中项目" Style="{StaticResource AccentButtonStyle}" Click="Clean_Click" IsEnabled="False" Padding="20,8" AutomationProperties.Name="清理选中的可清理项目"/>
          <TextBlock x:Name="CleanStatus" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
