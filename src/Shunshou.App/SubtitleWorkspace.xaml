<UserControl x:Class="Shunshou.App.SubtitleWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Padding="0,0,4,4">
        <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Severity="Informational" Closed="Notice_Closed" Title="使用须知" Message="字幕的著作权属于原网站与创作者；下载的字幕仅供个人学习使用，请勿传播或用于商业用途。"/>
        <Border Style="{StaticResource CardStyle}">
          <StackPanel Spacing="16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="提取视频字幕" FontSize="17"/>
              <TextBlock Grid.Column="1" Text="需联网" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center"/>
            </Grid>
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="UrlBox" Header="视频网页链接" PlaceholderText="https://…" AutomationProperties.Name="字幕来源视频链接" TextChanged="Url_Changed" KeyDown="Url_KeyDown"/>
              <Button x:Name="AnalyzeButton" Grid.Column="1" Content="读取字幕" VerticalAlignment="Bottom" Click="Analyze_Click"/>
            </Grid>
            <TextBlock x:Name="VideoTitle" Text="从视频网页读取已有字幕" TextWrapping="Wrap"/>
            <TextBlock x:Name="TrackHint" Text="保留时间轴，或导出纯文字。可选语言以网站提供的字幕为准。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="TrackBox" Header="字幕语言" HorizontalAlignment="Stretch" DisplayMemberPath="Label" IsEnabled="False"/>
              <ComboBox x:Name="FormatBox" Grid.Column="1" Header="保存格式" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="SRT · 带时间轴"/><ComboBoxItem Content="VTT · 网页字幕"/><ComboBoxItem Content="TXT · 纯文字"/></ComboBox>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="OutputBox" Header="保存到" AutomationProperties.Name="字幕输出文件夹"/>
          <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" VerticalAlignment="Bottom" Click="Browse_Click"/>
        </Grid></Border>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,12" Margin="0,0,4,0">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="6" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="准备就绪" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Height="3"/></StackPanel>
        <Button x:Name="OpenButton" Grid.Column="1" Content="打开输出" IsEnabled="False" Click="Open_Click" VerticalAlignment="Center"/>
        <Button x:Name="CancelButton" Grid.Column="2" Content="取消" IsEnabled="False" Click="Cancel_Click" VerticalAlignment="Center"/>
        <Button x:Name="StartButton" Grid.Column="3" Content="保存字幕" Style="{StaticResource AccentButtonStyle}" Padding="22,9" IsEnabled="False" Click="Start_Click" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
