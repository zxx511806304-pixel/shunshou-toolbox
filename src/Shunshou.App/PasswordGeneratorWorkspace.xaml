<UserControl x:Class="Shunshou.App.PasswordGeneratorWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <TextBlock Text="生成密码" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="密码只在本机内存生成，不保存、不上传；历史不会保留。复制后建议尽快粘贴使用，30 秒后可手动清理剪贴板。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <Grid ColumnSpacing="20" RowSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <NumberBox x:Name="LengthBox" Header="长度（4-128）" Minimum="4" Maximum="128" SmallChange="1" SpinButtonPlacementMode="Compact" Width="140" Value="16" AutomationProperties.Name="密码长度"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
            <CheckBox x:Name="UpperBox" Content="大写字母" IsChecked="True" AutomationProperties.Name="包含大写字母"/>
            <CheckBox x:Name="LowerBox" Content="小写字母" IsChecked="True" AutomationProperties.Name="包含小写字母"/>
            <CheckBox x:Name="DigitsBox" Content="数字" IsChecked="True" AutomationProperties.Name="包含数字"/>
            <CheckBox x:Name="SymbolsBox" Content="符号" IsChecked="True" AutomationProperties.Name="包含符号"/>
          </StackPanel>
          <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="ExcludeAmbiguousBox" Content="排除易混淆字符（0、O、1、l、I 等）" IsChecked="False" AutomationProperties.Name="排除易混淆字符"/>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
            <Button x:Name="GenerateButton" Content="生成密码" Style="{StaticResource AccentButtonStyle}" Click="Generate_Click" Padding="20,8" AutomationProperties.Name="生成密码"/>
            <Button x:Name="CopyButton" Content="复制" Click="Copy_Click" IsEnabled="False" AutomationProperties.Name="复制密码到剪贴板"/>
          </StackPanel>
        </Grid>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <TextBlock Text="生成的密码" FontSize="16" FontWeight="SemiBold"/>
        <TextBox x:Name="ResultBox" IsReadOnly="True" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" MinHeight="44" AutomationProperties.Name="生成的密码"/>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ProgressBar x:Name="StrengthBar" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" AutomationProperties.Name="密码强度"/>
          <TextBlock Grid.Column="1" x:Name="StrengthText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Right"/>
        </Grid>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedTextStyle}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
