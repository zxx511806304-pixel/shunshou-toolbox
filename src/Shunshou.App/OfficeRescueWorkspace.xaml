<UserControl x:Class="Shunshou.App.OfficeRescueWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardStyle}" Padding="18,14">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8">
          <TextBlock Text="找回未保存的文档" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="扫描 Word、Excel、PowerPoint 的自动恢复目录和 WPS 备份目录，找出程序崩溃或忘记保存时留下的文档。只读取和复制，不会修改原文件。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ScanButton" Content="扫描" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" Padding="20,8" AutomationProperties.Name="扫描自动保存文件"/>
            <Button x:Name="SaveButton" Content="保存到文件夹…" Click="Save_Click" IsEnabled="False" AutomationProperties.Name="把选中的文件复制到安全文件夹"/>
            <TextBlock x:Name="ScanStatus" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1" MinHeight="160">
          <ListView x:Name="Results" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="Results_SelectionChanged" AutomationProperties.Name="可恢复的自动保存文件列表">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid ColumnSpacing="12" Padding="2,6" ToolTipService.ToolTip="{Binding Path}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border VerticalAlignment="Top" Background="{ThemeResource AccentBrush}" CornerRadius="4" Padding="8,2">
                    <TextBlock Text="{Binding App}" FontSize="11" Foreground="{ThemeResource AccentForegroundBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding ModifiedText}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="EmptyLabel" Text="点击「扫描」查找自动保存的文件" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <InfoBar x:Name="ScanNotice" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14">
      <StackPanel Spacing="10">
        <TextBlock Text="提取损坏文档的内容" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="打不开或提示损坏的 Word、Excel、PowerPoint 文档（.docx / .xlsx / .pptx）本质上是一个压缩包，这里直接从中取出文字和图片。原文件不会被修改。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="PickButton" Content="选择文档" Click="Pick_Click" AutomationProperties.Name="选择损坏的 Office 文档"/>
          <Button x:Name="ExtractButton" Content="提取内容到文件夹…" Style="{StaticResource AccentButtonStyle}" Click="Extract_Click" IsEnabled="False" AutomationProperties.Name="提取文档内容到文件夹"/>
          <Button x:Name="OpenOutputButton" Content="打开输出文件夹" Click="OpenOutput_Click" Visibility="Collapsed" AutomationProperties.Name="打开提取结果所在文件夹"/>
        </StackPanel>
        <TextBlock x:Name="SelectedFileLabel" Text="尚未选择文档" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
        <InfoBar x:Name="ExtractNotice" IsOpen="False" IsClosable="True" Severity="Warning"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
