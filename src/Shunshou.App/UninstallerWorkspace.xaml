<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Shunshou.App.UninstallerWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Shunshou.App">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="搜索软件名称或发布者" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="搜索已安装的软件"/>
      <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click"/>
      <Button x:Name="RestoreButton" Grid.Column="2" Content="恢复备份" Click="Restore_Click"/>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}" Padding="10">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="ApplicationCount" Text="已安装软件" FontWeight="SemiBold" Margin="5,2"/>
          <ListView x:Name="Applications" Grid.Row="1" MaxHeight="600" SelectionMode="Single" SelectionChanged="Applications_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="已安装软件列表">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:InstalledAppRow">
                <Grid Padding="1,7" ColumnSpacing="10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE71D;" FontSize="23" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                  <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Publisher}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Detail}" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Spacing="5">
            <TextBlock x:Name="AppName" Text="选择要管理的软件" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="AppDetail" Foreground="{ThemeResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="InstallLocation" Foreground="{ThemeResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/>
            <TextBlock x:Name="EntryStatus" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="UninstallButton" Content="正常卸载" Style="{StaticResource AccentButtonStyle}" Click="Uninstall_Click" IsEnabled="False"/>
              <Button x:Name="ScanButton" Content="检查关联文件" Click="Scan_Click" IsEnabled="False"/>
              <Button x:Name="AdminButton" Content="管理员打开" Click="Admin_Click" Visibility="Collapsed" IsEnabled="False"/>
            </StackPanel>
            <CheckBox x:Name="IncludeRegistration" Content="同时检查卸载列表记录" IsEnabled="False"/>
          </StackPanel>
          <Grid x:Name="CandidateWorkspace" Grid.Row="2" RowSpacing="7">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock x:Name="ScanCount" Text="检查后在这里选择需要清理的条目" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
            <ListView x:Name="Candidates" Grid.Row="1" MaxHeight="420" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.Name="关联文件与设置，勾选后清理，默认未选中">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LeftoverRow">
                  <Grid Padding="0,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" Width="24" Padding="0" VerticalAlignment="Top" AutomationProperties.Name="{x:Bind SelectionLabel}"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{x:Bind Path}" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True"/>
                      <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Text="{x:Bind Reason}" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
          <Grid x:Name="CleanupFooter" Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectedCount" Text="尚未选择条目" Foreground="{ThemeResource MutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="CleanupButton" Grid.Column="1" Content="备份并清理所选" Click="Cleanup_Click" IsEnabled="False"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    <InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True"/>
    <Grid Grid.Row="3" ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="5"><TextBlock x:Name="ProgressText" Text="先正常卸载，再检查需要清理的文件与设置。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" IsIndeterminate="False" Value="0" Height="3"/></StackPanel>
      <Button x:Name="CancelButton" Grid.Column="1" Content="取消" Click="Cancel_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</UserControl>
