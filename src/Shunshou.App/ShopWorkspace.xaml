<UserControl x:Class="Shunshou.App.ShopWorkspace" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="Workspace_SizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Padding="0,0,0,8">
      <Grid x:Name="StoreCards" ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}" Padding="24">
          <StackPanel Spacing="16">
            <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="9" Width="44" Height="44" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8EA;" FontSize="21" Foreground="{ThemeResource BrandBrush}"/></Border>
            <TextBlock Text="手机卡与宽带" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="流量套餐 · 通话套餐&#x0a;宽带办理" Style="{StaticResource MutedTextStyle}"/>
            <Button x:Name="SimStoreButton" Click="SimStore_Click" IsEnabled="False" Padding="14,10" Background="{ThemeResource BrandSoftBrush}" Foreground="{ThemeResource BrandBrush}" AutomationProperties.Name="浏览手机卡与宽带套餐"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="浏览套餐"/><FontIcon Glyph="&#xE8A7;" FontSize="13"/></StackPanel></Button>
          </StackPanel>
        </Border>
        <Border x:Name="MembershipCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
          <StackPanel Spacing="16">
            <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="9" Width="44" Height="44" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8EB;" FontSize="21" Foreground="{ThemeResource BrandBrush}"/></Border>
            <TextBlock Text="会员与生活优惠" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="影音 · 办公设计 · 网盘&#x0a;餐饮与外卖优惠" Style="{StaticResource MutedTextStyle}"/>
            <Button x:Name="MembershipStoreButton" Click="MembershipStore_Click" IsEnabled="False" Padding="14,10" Background="{ThemeResource BrandSoftBrush}" Foreground="{ThemeResource BrandBrush}" AutomationProperties.Name="浏览会员与生活优惠"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="浏览会员与优惠"/><FontIcon Glyph="&#xE8A7;" FontSize="13"/></StackPanel></Button>
          </StackPanel>
        </Border>
      </Grid>
      <Button x:Name="QrButton" HorizontalAlignment="Right" Width="40" Height="40" Padding="9" IsEnabled="False" Click="Qr_Click" AutomationProperties.Name="查看客服二维码"><FontIcon Glyph="&#xED14;" FontSize="20" Foreground="{ThemeResource MutedBrush}"/></Button>
      <InfoBar x:Name="ShopError" IsOpen="False" IsClosable="True" Severity="Error"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
