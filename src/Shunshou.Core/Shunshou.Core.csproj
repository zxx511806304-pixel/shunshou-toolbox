<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="RapidOcrNet" Version="4.1.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="DiscUtils.Ntfs" Version="0.16.13" />
    <!-- The package's legacy build target requires a solution Platform setting. The product is x64;
         use its pinned x64 assembly directly so transitive callers need no special build arguments. -->
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" GeneratePathProperty="true" ExcludeAssets="build" />
    <Reference Include="ScreenRecorderLib">
      <HintPath>$(PkgScreenRecorderLib)\build\x64\ScreenRecorderLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shunshou.SmokeTests" />
    <InternalsVisibleTo Include="Shunshou.ScreenRecording.Tests" />
    <EmbeddedResource Include="Resources/ShopResources.bin" LogicalName="Shunshou.Core.ShopResources.bin" />
  </ItemGroup>
</Project>
